# 백엔드 API (기본값: 내장 mock 백엔드)
AUTH_BACKEND_URL=http://localhost:3000/mock-backend
# AT 서명 검증 키 (mock 백엔드와 공유, 실제 백엔드는 JWKS로 교체)
AUTH_JWT_SECRET=
# AT 만료 몇 초 전부터 proxy가 갱신할지
AUTH_REFRESH_SKEW_SEC=60

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# mock 백엔드 토큰 TTL (시나리오 테스트 시 20 / skew 10 추천)
MOCK_AT_TTL_SEC=30
MOCK_RT_TTL_SEC=86400
